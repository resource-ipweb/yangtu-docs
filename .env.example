# 在线调试 API Base URL
# docusaurus.config.ts 在启动时加载：.env.development（start）、.env.production（build）
# 个人覆盖可复制为 .env.local（已 gitignore）

# ---------- 生产（.env.production）----------
# DOCS_API_BASE_URL=https://006ip.com
# DOCS_API_DEV_BASE_URL=/api-user

# ---------- 开发（.env.development）----------
# DOCS_API_BASE_URL=http://localhost:20021
# DOCS_API_DEV_BASE_URL=/api

# 本地 dev 代理（devBaseUrl 为相对路径如 /api 时，转发到此后端）
# DOCS_API_DEV_PROXY_TARGET=http://localhost:20021
# DOCS_API_DEV_PROXY_PATH=/api
